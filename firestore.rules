rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSourceFacts(facts) {
      return facts is list
        && facts.size() >= 1
        && facts.size() <= 4
        && facts[0] is string && facts[0].size() >= 3 && facts[0].size() <= 120
        && (facts.size() < 2 || (facts[1] is string && facts[1].size() >= 3 && facts[1].size() <= 120))
        && (facts.size() < 3 || (facts[2] is string && facts[2].size() >= 3 && facts[2].size() <= 120))
        && (facts.size() < 4 || (facts[3] is string && facts[3].size() >= 3 && facts[3].size() <= 120));
    }

    function validResearchSource(source, planId) {
      return source is map
        && source.keys().hasOnly(['kind', 'title', 'locator', 'domain', 'publishedAt', 'retrievedAt', 'searchQueries'])
        && source.kind in ['web', 'workspace']
        && source.title is string && source.title.size() >= 3 && source.title.size() <= 200
        && source.locator is string && source.locator.size() >= 3 && source.locator.size() <= 1000
        && ((source.kind == 'web' && source.locator.matches('^https://.+'))
          || (source.kind == 'workspace' && source.locator == 'workspace/plans/' + planId))
        && (source.domain == null || (source.domain is string && source.domain.size() >= 3 && source.domain.size() <= 200))
        && (source.publishedAt == null || (source.publishedAt is string && source.publishedAt.size() >= 20 && source.publishedAt.size() <= 40))
        && source.retrievedAt is string && source.retrievedAt.size() >= 20 && source.retrievedAt.size() <= 40
        && (!source.keys().hasAny(['searchQueries']) || (
          source.searchQueries is list && source.searchQueries.size() <= 3
          && (source.searchQueries.size() < 1 || (source.searchQueries[0] is string && source.searchQueries[0].size() >= 1 && source.searchQueries[0].size() <= 200))
          && (source.searchQueries.size() < 2 || (source.searchQueries[1] is string && source.searchQueries[1].size() >= 1 && source.searchQueries[1].size() <= 200))
          && (source.searchQueries.size() < 3 || (source.searchQueries[2] is string && source.searchQueries[2].size() >= 1 && source.searchQueries[2].size() <= 200))
        ));
    }

    function validResearchIds(ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 3
        && ids.toSet().size() == ids.size()
        && ids[0] is string && ids[0].size() >= 8 && ids[0].size() <= 128
        && (ids.size() < 2 || (ids[1] is string && ids[1].size() >= 8 && ids[1].size() <= 128))
        && (ids.size() < 3 || (ids[2] is string && ids[2].size() >= 8 && ids[2].size() <= 128));
    }

    function acceptedResearch(uid, workspaceId, planId, researchId) {
      return exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchState/$(researchId))
        && get(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchState/$(researchId)).data.currentDecision == 'accepted';
    }

    function allResearchAccepted(uid, workspaceId, planId, ids) {
      return acceptedResearch(uid, workspaceId, planId, ids[0])
        && (ids.size() < 2 || acceptedResearch(uid, workspaceId, planId, ids[1]))
        && (ids.size() < 3 || acceptedResearch(uid, workspaceId, planId, ids[2]));
    }

    function validAchievementEvidenceItem(item) {
      return item is map
        && item.keys().hasOnly(['label', 'url'])
        && item.label is string && item.label.size() >= 3 && item.label.size() <= 160
        && (item.url == null || (item.url is string && item.url.size() <= 1000 && item.url.matches('^https://[^\\s]+$')));
    }

    function validAchievementEvidence(items) {
      return items is list && items.size() >= 1 && items.size() <= 3
        && validAchievementEvidenceItem(items[0])
        && (items.size() < 2 || validAchievementEvidenceItem(items[1]))
        && (items.size() < 3 || validAchievementEvidenceItem(items[2]));
    }

    function validReflectionFields(fields) {
      return fields is list && fields.size() <= 3
        && fields.toSet().size() == fields.size()
        && fields.hasOnly(['whatWorked', 'whatChanged', 'doDifferently']);
    }

    function validCompletionIds(ids) {
      return ids is list && ids.size() == 1
        && ids[0] is string && ids[0].size() >= 8 && ids[0].size() <= 128;
    }

    function approvedReflectionExists(uid, workspaceId, planId, reflectionId, fields) {
      return fields.size() == 0 || (
        reflectionId is string
        && existsAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reflections/$(reflectionId))
        && (!fields.hasAny(['whatWorked']) || getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reflections/$(reflectionId)).data.whatWorked.size() > 0)
        && (!fields.hasAny(['whatChanged']) || getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reflections/$(reflectionId)).data.whatChanged.size() > 0)
        && (!fields.hasAny(['doDifferently']) || getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reflections/$(reflectionId)).data.doDifferently.size() > 0)
      );
    }

    function resourcePlanScheduleVersion(uid, workspaceId, planId) {
      return get(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)).data.scheduleVersion;
    }

    function validPlanCompletionUpdate(uid, workspaceId, planId) {
      return resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.schemaVersion == 3
        && request.resource.data.achievementId is string
        && request.resource.data.achievementId.size() >= 8
        && request.resource.data.achievementId.size() <= 128
        && request.resource.data.completedAt == request.time
        && request.resource.data.completionVersion == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'schemaVersion', 'achievementId', 'completedAt',
          'completionVersion', 'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievements/$(request.resource.data.achievementId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievementState/current).data.currentAchievementId == request.resource.data.achievementId;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid;
      allow delete: if false;

      match /workspaces/{workspaceId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.id == workspaceId
          && request.resource.data.keys().hasOnly([
            'id', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'
          ]);
        allow update: if false;
        allow delete: if false;

        match /plans/{planId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'clientRequestId', 'title',
              'outcome', 'why', 'targetDate', 'weeklyHours', 'workingDays',
              'status', 'schemaVersion', 'scheduleVersion', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.id == planId
            && request.resource.data.clientRequestId == planId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.schemaVersion == 2
            && request.resource.data.scheduleVersion == 1
            && request.resource.data.status == 'active'
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 80
            && request.resource.data.outcome is string
            && request.resource.data.outcome.size() >= 10
            && request.resource.data.outcome.size() <= 300
            && request.resource.data.why is string
            && request.resource.data.why.size() >= 10
            && request.resource.data.why.size() <= 300
            && request.resource.data.targetDate is string
            && request.resource.data.targetDate.size() == 10
            && request.resource.data.targetDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.weeklyHours is int
            && request.resource.data.weeklyHours >= 1
            && request.resource.data.weeklyHours <= 40
            && request.resource.data.workingDays is list
            && request.resource.data.workingDays.size() >= 1
            && request.resource.data.workingDays.size() <= 7
            && request.resource.data.workingDays.toSet().size() == request.resource.data.workingDays.size()
            && request.resource.data.workingDays
              .hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']);
          allow update: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.id == resource.data.id
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.clientRequestId == resource.data.clientRequestId
            && request.resource.data.title == resource.data.title
            && request.resource.data.outcome == resource.data.outcome
            && request.resource.data.why == resource.data.why
            && request.resource.data.targetDate == resource.data.targetDate
            && request.resource.data.createdAt == resource.data.createdAt
            && (
              (request.resource.data.status == resource.data.status
                && request.resource.data.status == 'active'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['workingDays', 'weeklyHours', 'schemaVersion', 'scheduleVersion', 'updatedAt'])
                && request.resource.data.schemaVersion == 2
                && request.resource.data.scheduleVersion == (
                  resource.data.keys().hasAll(['scheduleVersion'])
                    ? resource.data.scheduleVersion + 1
                    : 1
                )
                && request.resource.data.weeklyHours is int
                && request.resource.data.weeklyHours >= 1
                && request.resource.data.weeklyHours <= 40
                && request.resource.data.workingDays is list
                && request.resource.data.workingDays.size() >= 1
                && request.resource.data.workingDays.size() <= 7
                && request.resource.data.workingDays.toSet().size() == request.resource.data.workingDays.size()
                && request.resource.data.workingDays
                  .hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']))
              || validPlanCompletionUpdate(uid, workspaceId, planId)
            );
          allow delete: if false;

          match /records/{recordId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId))
              && request.resource.data.keys().hasOnly([
                'recordId', 'kind', 'planId', 'ownerUid', 'workspaceId',
                'summary', 'rationale', 'confidence', 'sourceFacts',
                'sourceRecommendationId', 'requestFingerprint', 'schemaVersion',
                'recordedAt'
              ])
              && request.resource.data.recordId == recordId
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.kind in ['decision', 'clara-guidance']
              && request.resource.data.summary is string
              && request.resource.data.summary.size() >= 3
              && request.resource.data.summary.size() <= 500
              && request.resource.data.rationale is string
              && request.resource.data.rationale.size() >= 10
              && request.resource.data.rationale.size() <= 500
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 2000
              && request.resource.data.schemaVersion == 1
              && request.resource.data.recordedAt == request.time
              && (
                (request.resource.data.kind == 'decision'
                  && request.resource.data.confidence == null
                  && request.resource.data.sourceFacts == []
                  && request.resource.data.sourceRecommendationId == null)
                ||
                (request.resource.data.kind == 'clara-guidance'
                  && request.resource.data.confidence in ['low', 'medium', 'high']
                  && validSourceFacts(request.resource.data.sourceFacts)
                  && request.resource.data.sourceRecommendationId is string
                  && request.resource.data.sourceRecommendationId.size() >= 8
                  && request.resource.data.sourceRecommendationId.size() <= 128)
              );
            allow update, delete: if false;
          }

          match /research/{researchId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId))
              && existsAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchState/$(researchId))
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'researchId', 'requestId', 'sourcePlanId', 'headline',
                'finding', 'source', 'planId', 'ownerUid', 'workspaceId',
                'cardFingerprint', 'createdAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.researchId == researchId
              && request.resource.data.requestId is string
              && request.resource.data.requestId.size() >= 8
              && request.resource.data.requestId.size() <= 128
              && request.resource.data.sourcePlanId == planId
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.headline is string
              && request.resource.data.headline.size() >= 3
              && request.resource.data.headline.size() <= 160
              && request.resource.data.finding is string
              && request.resource.data.finding.size() >= 10
              && request.resource.data.finding.size() <= 800
              && validResearchSource(request.resource.data.source, planId)
              && request.resource.data.cardFingerprint is string
              && request.resource.data.cardFingerprint.size() >= 1
              && request.resource.data.cardFingerprint.size() <= 5000
              && request.resource.data.createdAt == request.time;
            allow update, delete: if false;
          }

          match /researchReviews/{reviewId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'reviewId', 'researchId', 'planId', 'ownerUid',
                'workspaceId', 'decision', 'revision', 'requestFingerprint', 'reviewedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.reviewId == reviewId
              && request.resource.data.researchId is string
              && request.resource.data.researchId.size() >= 8
              && request.resource.data.researchId.size() <= 128
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.decision in ['accepted', 'rejected', 'deferred']
              && request.resource.data.revision is int
              && request.resource.data.revision >= 1
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 5000
              && request.resource.data.reviewedAt == request.time
              && existsAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/research/$(request.resource.data.researchId))
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchState/$(request.resource.data.researchId)).data.latestReviewId == reviewId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchState/$(request.resource.data.researchId)).data.revision == request.resource.data.revision;
            allow update, delete: if false;
          }

          match /researchState/{researchId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'researchId', 'planId', 'ownerUid', 'workspaceId',
                'currentDecision', 'revision', 'latestReviewId', 'reviewedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.researchId == researchId
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.currentDecision in ['accepted', 'rejected', 'deferred']
              && request.resource.data.revision == 1
              && request.resource.data.latestReviewId is string
              && request.resource.data.latestReviewId.size() >= 8
              && request.resource.data.latestReviewId.size() <= 128
              && request.resource.data.reviewedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchReviews/$(request.resource.data.latestReviewId)).data.researchId == researchId;
            allow update: if owns(uid)
              && request.resource.data.keys() == resource.data.keys()
              && request.resource.data.schemaVersion == resource.data.schemaVersion
              && request.resource.data.researchId == resource.data.researchId
              && request.resource.data.planId == resource.data.planId
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == resource.data.workspaceId
              && request.resource.data.currentDecision in ['accepted', 'rejected', 'deferred']
              && request.resource.data.revision == resource.data.revision + 1
              && request.resource.data.latestReviewId is string
              && request.resource.data.latestReviewId.size() >= 8
              && request.resource.data.latestReviewId.size() <= 128
              && request.resource.data.reviewedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/researchReviews/$(request.resource.data.latestReviewId)).data.revision == request.resource.data.revision;
            allow delete: if false;
          }

          match /briefVersions/{versionId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'versionId', 'version', 'planId', 'ownerUid',
                'workspaceId', 'focus', 'approach', 'successEvidence',
                'sourceResearchIds', 'requestFingerprint', 'recordedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.versionId == versionId
              && request.resource.data.version is int
              && request.resource.data.version >= 1
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.focus is string
              && request.resource.data.focus.size() >= 3
              && request.resource.data.focus.size() <= 160
              && request.resource.data.approach is string
              && request.resource.data.approach.size() >= 10
              && request.resource.data.approach.size() <= 1000
              && request.resource.data.successEvidence is string
              && request.resource.data.successEvidence.size() >= 10
              && request.resource.data.successEvidence.size() <= 600
              && validResearchIds(request.resource.data.sourceResearchIds)
              && allResearchAccepted(uid, workspaceId, planId, request.resource.data.sourceResearchIds)
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 5000
              && request.resource.data.recordedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/briefState/current).data.currentVersionId == versionId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/briefState/current).data.currentVersion == request.resource.data.version;
            allow update, delete: if false;
          }

          match /briefState/{stateId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && stateId == 'current'
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'planId', 'ownerUid', 'workspaceId',
                'currentVersion', 'currentVersionId', 'updatedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.currentVersion == 1
              && request.resource.data.currentVersionId is string
              && request.resource.data.currentVersionId.size() >= 8
              && request.resource.data.currentVersionId.size() <= 128
              && request.resource.data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/briefVersions/$(request.resource.data.currentVersionId)).data.version == 1;
            allow update: if owns(uid)
              && stateId == 'current'
              && request.resource.data.keys() == resource.data.keys()
              && request.resource.data.schemaVersion == resource.data.schemaVersion
              && request.resource.data.planId == resource.data.planId
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == resource.data.workspaceId
              && request.resource.data.currentVersion == resource.data.currentVersion + 1
              && request.resource.data.currentVersionId is string
              && request.resource.data.currentVersionId.size() >= 8
              && request.resource.data.currentVersionId.size() <= 128
              && request.resource.data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/briefVersions/$(request.resource.data.currentVersionId)).data.version == request.resource.data.currentVersion;
            allow delete: if false;
          }

          match /achievements/{achievementId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'achievementId', 'planId', 'ownerUid', 'workspaceId',
                'outcome', 'evidence', 'completedStepIds', 'expectedPlanRevision',
                'reflectionId', 'requestFingerprint', 'recordedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.achievementId == achievementId
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.outcome is string
              && request.resource.data.outcome.size() >= 10
              && request.resource.data.outcome.size() <= 600
              && validAchievementEvidence(request.resource.data.evidence)
              && validCompletionIds(request.resource.data.completedStepIds)
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/todayCompletions/$(request.resource.data.completedStepIds[0])).data.planId == planId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/todayCompletions/$(request.resource.data.completedStepIds[0])).data.status == 'completed'
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/todayCompletions/$(request.resource.data.completedStepIds[0])).data.stepKey == 'first-proof-v1'
              && request.resource.data.expectedPlanRevision is int
              && request.resource.data.expectedPlanRevision == resourcePlanScheduleVersion(uid, workspaceId, planId)
              && (request.resource.data.reflectionId == null || (request.resource.data.reflectionId is string && request.resource.data.reflectionId.size() >= 8 && request.resource.data.reflectionId.size() <= 128))
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 10000
              && request.resource.data.recordedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)).data.achievementId == achievementId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievementState/current).data.currentAchievementId == achievementId;
            allow update, delete: if false;
          }

          match /reflections/{reflectionId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'reflectionId', 'achievementId', 'planId', 'ownerUid',
                'workspaceId', 'whatWorked', 'whatChanged', 'doDifferently', 'recordedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.reflectionId == reflectionId
              && request.resource.data.achievementId is string
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.whatWorked is string && request.resource.data.whatWorked.size() <= 1000
              && request.resource.data.whatChanged is string && request.resource.data.whatChanged.size() <= 1000
              && request.resource.data.doDifferently is string && request.resource.data.doDifferently.size() <= 1000
              && (request.resource.data.whatWorked.size() > 0 || request.resource.data.whatChanged.size() > 0 || request.resource.data.doDifferently.size() > 0)
              && request.resource.data.recordedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievements/$(request.resource.data.achievementId)).data.reflectionId == reflectionId;
            allow update, delete: if false;
          }

          match /reuseConsents/{consentId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'consentId', 'achievementId', 'reflectionId', 'planId',
                'ownerUid', 'workspaceId', 'purpose', 'approvedReflectionFields',
                'version', 'previousConsentId', 'requestFingerprint', 'recordedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.consentId == consentId
              && request.resource.data.achievementId is string
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.purpose == 'future_plan_guidance'
              && validReflectionFields(request.resource.data.approvedReflectionFields)
              && approvedReflectionExists(uid, workspaceId, planId, request.resource.data.reflectionId, request.resource.data.approvedReflectionFields)
              && request.resource.data.version is int && request.resource.data.version >= 1
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 5000
              && request.resource.data.recordedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievementState/current).data.currentConsentId == consentId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievementState/current).data.consentVersion == request.resource.data.version
              && (
                (request.resource.data.version == 1
                  && request.resource.data.previousConsentId == null
                  && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievements/$(request.resource.data.achievementId)).data.reflectionId == request.resource.data.reflectionId)
                ||
                (request.resource.data.version > 1
                  && request.resource.data.approvedReflectionFields.size() == 0
                  && request.resource.data.previousConsentId is string
                  && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.previousConsentId))
                  && get(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.previousConsentId)).data.version == request.resource.data.version - 1
                  && get(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.previousConsentId)).data.achievementId == request.resource.data.achievementId)
              );
            allow update, delete: if false;
          }

          match /achievementState/{stateId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && stateId == 'current'
              && workspaceId == 'default'
              && request.resource.data.keys().hasOnly([
                'schemaVersion', 'planId', 'ownerUid', 'workspaceId', 'currentAchievementId',
                'currentConsentId', 'consentVersion', 'updatedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.currentAchievementId is string
              && request.resource.data.currentConsentId is string
              && request.resource.data.consentVersion == 1
              && request.resource.data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/achievements/$(request.resource.data.currentAchievementId)).data.achievementId == request.resource.data.currentAchievementId
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.currentConsentId)).data.version == 1;
            allow update: if owns(uid)
              && stateId == 'current'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentConsentId', 'consentVersion', 'updatedAt'])
              && request.resource.data.consentVersion == resource.data.consentVersion + 1
              && request.resource.data.updatedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.currentConsentId)).data.version == request.resource.data.consentVersion
              && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId)/reuseConsents/$(request.resource.data.currentConsentId)).data.achievementId == resource.data.currentAchievementId;
            allow delete: if false;
          }
        }

        match /auditEvents/{eventId} {
          allow read: if owns(uid);
          allow create, update, delete: if false;
        }

        match /todayCompletions/{completionId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'planId', 'stepKey',
              'completedDate', 'durationMinutes', 'status', 'schemaVersion',
              'completedAt'
            ])
            && request.resource.data.id == completionId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.stepKey == 'first-proof-v1'
            && request.resource.data.completedDate is string
            && request.resource.data.completedDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 30
            && request.resource.data.durationMinutes <= 60
            && request.resource.data.status == 'completed'
            && request.resource.data.schemaVersion == 1
            && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(request.resource.data.planId));
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
