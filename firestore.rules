rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSourceFacts(facts) {
      return facts is list
        && facts.size() >= 1
        && facts.size() <= 4
        && facts[0] is string && facts[0].size() >= 3 && facts[0].size() <= 120
        && (facts.size() < 2 || (facts[1] is string && facts[1].size() >= 3 && facts[1].size() <= 120))
        && (facts.size() < 3 || (facts[2] is string && facts[2].size() >= 3 && facts[2].size() <= 120))
        && (facts.size() < 4 || (facts[3] is string && facts[3].size() >= 3 && facts[3].size() <= 120));
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid;
      allow delete: if false;

      match /workspaces/{workspaceId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.id == workspaceId
          && request.resource.data.keys().hasOnly([
            'id', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'
          ]);
        allow update: if false;
        allow delete: if false;

        match /plans/{planId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'clientRequestId', 'title',
              'outcome', 'why', 'targetDate', 'weeklyHours', 'workingDays',
              'status', 'schemaVersion', 'scheduleVersion', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.id == planId
            && request.resource.data.clientRequestId == planId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.schemaVersion == 2
            && request.resource.data.scheduleVersion == 1
            && request.resource.data.status == 'active'
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 80
            && request.resource.data.outcome is string
            && request.resource.data.outcome.size() >= 10
            && request.resource.data.outcome.size() <= 300
            && request.resource.data.why is string
            && request.resource.data.why.size() >= 10
            && request.resource.data.why.size() <= 300
            && request.resource.data.targetDate is string
            && request.resource.data.targetDate.size() == 10
            && request.resource.data.targetDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.weeklyHours is int
            && request.resource.data.weeklyHours >= 1
            && request.resource.data.weeklyHours <= 40
            && request.resource.data.workingDays is list
            && request.resource.data.workingDays.size() >= 1
            && request.resource.data.workingDays.size() <= 7
            && request.resource.data.workingDays.toSet().size() == request.resource.data.workingDays.size()
            && request.resource.data.workingDays
              .hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']);
          allow update: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.id == resource.data.id
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.clientRequestId == resource.data.clientRequestId
            && request.resource.data.title == resource.data.title
            && request.resource.data.outcome == resource.data.outcome
            && request.resource.data.why == resource.data.why
            && request.resource.data.targetDate == resource.data.targetDate
            && request.resource.data.status == resource.data.status
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['workingDays', 'weeklyHours', 'schemaVersion', 'scheduleVersion', 'updatedAt'])
            && request.resource.data.schemaVersion == 2
            && request.resource.data.scheduleVersion == (
              resource.data.keys().hasAll(['scheduleVersion'])
                ? resource.data.scheduleVersion + 1
                : 1
            )
            && request.resource.data.weeklyHours is int
            && request.resource.data.weeklyHours >= 1
            && request.resource.data.weeklyHours <= 40
            && request.resource.data.workingDays is list
            && request.resource.data.workingDays.size() >= 1
            && request.resource.data.workingDays.size() <= 7
            && request.resource.data.workingDays.toSet().size() == request.resource.data.workingDays.size()
            && request.resource.data.workingDays
              .hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']);
          allow delete: if false;

          match /records/{recordId} {
            allow read: if owns(uid);
            allow create: if owns(uid)
              && workspaceId == 'default'
              && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(planId))
              && request.resource.data.keys().hasOnly([
                'recordId', 'kind', 'planId', 'ownerUid', 'workspaceId',
                'summary', 'rationale', 'confidence', 'sourceFacts',
                'sourceRecommendationId', 'requestFingerprint', 'schemaVersion',
                'recordedAt'
              ])
              && request.resource.data.recordId == recordId
              && request.resource.data.planId == planId
              && request.resource.data.ownerUid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.kind in ['decision', 'clara-guidance']
              && request.resource.data.summary is string
              && request.resource.data.summary.size() >= 3
              && request.resource.data.summary.size() <= 500
              && request.resource.data.rationale is string
              && request.resource.data.rationale.size() >= 10
              && request.resource.data.rationale.size() <= 500
              && request.resource.data.requestFingerprint is string
              && request.resource.data.requestFingerprint.size() >= 1
              && request.resource.data.requestFingerprint.size() <= 2000
              && request.resource.data.schemaVersion == 1
              && request.resource.data.recordedAt == request.time
              && (
                (request.resource.data.kind == 'decision'
                  && request.resource.data.confidence == null
                  && request.resource.data.sourceFacts == []
                  && request.resource.data.sourceRecommendationId == null)
                ||
                (request.resource.data.kind == 'clara-guidance'
                  && request.resource.data.confidence in ['low', 'medium', 'high']
                  && validSourceFacts(request.resource.data.sourceFacts)
                  && request.resource.data.sourceRecommendationId is string
                  && request.resource.data.sourceRecommendationId.size() >= 8
                  && request.resource.data.sourceRecommendationId.size() <= 128)
              );
            allow update, delete: if false;
          }
        }

        match /auditEvents/{eventId} {
          allow read: if owns(uid);
          allow create, update, delete: if false;
        }

        match /todayCompletions/{completionId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'planId', 'stepKey',
              'completedDate', 'durationMinutes', 'status', 'schemaVersion',
              'completedAt'
            ])
            && request.resource.data.id == completionId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.stepKey == 'first-proof-v1'
            && request.resource.data.completedDate is string
            && request.resource.data.completedDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 30
            && request.resource.data.durationMinutes <= 60
            && request.resource.data.status == 'completed'
            && request.resource.data.schemaVersion == 1
            && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(request.resource.data.planId));
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
