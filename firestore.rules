rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid;
      allow delete: if false;

      match /workspaces/{workspaceId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.id == workspaceId
          && request.resource.data.keys().hasOnly([
            'id', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt',
            'availability', 'availabilityVersion'
          ]);
        allow update: if owns(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerUid == uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.keys().hasOnly([
            'id', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt',
            'availability', 'availabilityVersion'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['availability', 'availabilityVersion', 'updatedAt'])
          && request.resource.data.availabilityVersion is int
          && request.resource.data.availabilityVersion == (
            resource.data.keys().hasAll(['availabilityVersion'])
              ? resource.data.availabilityVersion + 1
              : 1
          )
          && request.resource.data.availability is map
          && request.resource.data.availability.keys().hasOnly([
            'workingDays', 'weeklyHours', 'preferredTime', 'schemaVersion', 'version'
          ])
          && request.resource.data.availability.workingDays is list
          && request.resource.data.availability.workingDays.size() >= 1
          && request.resource.data.availability.workingDays.size() <= 7
          && request.resource.data.availability.workingDays
            .hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
          && request.resource.data.availability.weeklyHours is int
          && request.resource.data.availability.weeklyHours >= 1
          && request.resource.data.availability.weeklyHours <= 40
          && request.resource.data.availability.preferredTime in ['morning', 'afternoon', 'evening']
          && request.resource.data.availability.schemaVersion == 1
          && request.resource.data.availability.version == request.resource.data.availabilityVersion;
        allow delete: if false;

        match /plans/{planId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'clientRequestId', 'title',
              'outcome', 'why', 'targetDate', 'weeklyHours', 'status',
              'schemaVersion', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.id == planId
            && request.resource.data.clientRequestId == planId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.schemaVersion == 1
            && request.resource.data.status == 'active'
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 80
            && request.resource.data.outcome is string
            && request.resource.data.outcome.size() >= 10
            && request.resource.data.outcome.size() <= 300
            && request.resource.data.why is string
            && request.resource.data.why.size() >= 10
            && request.resource.data.why.size() <= 300
            && request.resource.data.targetDate is string
            && request.resource.data.targetDate.size() == 10
            && request.resource.data.targetDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.weeklyHours is int
            && request.resource.data.weeklyHours >= 1
            && request.resource.data.weeklyHours <= 40;
          allow update, delete: if false;
        }

        match /todayCompletions/{completionId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && workspaceId == 'default'
            && request.resource.data.keys().hasOnly([
              'id', 'ownerUid', 'workspaceId', 'planId', 'stepKey',
              'completedDate', 'durationMinutes', 'status', 'schemaVersion',
              'completedAt'
            ])
            && request.resource.data.id == completionId
            && request.resource.data.ownerUid == uid
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.stepKey == 'first-proof-v1'
            && request.resource.data.completedDate is string
            && request.resource.data.completedDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 30
            && request.resource.data.durationMinutes <= 60
            && request.resource.data.status == 'completed'
            && request.resource.data.schemaVersion == 1
            && exists(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/plans/$(request.resource.data.planId));
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
