{
  "name": "longview-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "firebase emulators:exec --project longview-505611 --only auth,firestore \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "build:production": "VITE_USE_FIREBASE_EMULATORS=false VITE_USE_FIRESTORE_EMULATOR=false VITE_CLARA_API_URL=https://longview-clara-api-112452643430.asia-south1.run.app VITE_RELEASE_SURFACE=release-four npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:release-four": "playwright test --config=playwright.release-four.config.ts",
    "emulators": "firebase emulators:start --project longview-505611"
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "firebase-tools": "^15.27.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
